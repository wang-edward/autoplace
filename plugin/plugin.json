{
    "$schema": "https://go.kicad.org/api/schemas/v1",
    "identifier": "com.github.wang-edward.autoplace",
    "name": "autoplace",
    "description": "Analytical footprint placer",
    "runtime": {
        "type": "python"
    },
    "actions": [
        {
            "identifier": "run_placer",
            "name": "Run autoplace",
            "description": "Run the analytical placer on the current board",
            "scopes": [
                "pcb"
            ],
            "entrypoint": "run.py",
            "show-button": true
        }
    ]
}
